# SchemeSathi Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Application
APP_NAME=SchemeSathi
API_V1_PREFIX=/api

# Security & JWT (Replace with strong random secret in production)
SECRET_KEY=schemesathi_super_secure_secret_key_2025_change_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: Local zero-configuration SQLite database
DATABASE_URL=sqlite:///./schemesathi.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/schemesathi

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
